{
  "name": "chuya",
  "version": "1.0.0",
  "private": true,
  "description": "CHUYA — Luxury Indian Handbag E-Commerce Platform",
  "scripts": {
    "dev:storefront": "pnpm --filter storefront dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:api": "pnpm --filter api dev",
    "dev": "pnpm run --parallel dev:storefront dev:admin dev:api",
    "build:storefront": "pnpm --filter storefront build",
    "build:admin": "pnpm --filter admin build",
    "build:api": "pnpm --filter api build",
    "build": "pnpm run build:storefront && pnpm run build:admin && pnpm run build:api",
    "lint": "pnpm run --parallel lint",
    "typecheck": "pnpm run --parallel typecheck"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
